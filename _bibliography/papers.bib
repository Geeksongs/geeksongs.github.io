@article{song2026asyncrobosim,
  category={preprint},
  abbr={Preprint},
  title={Simulation for Evaluating Robot Policies Should Be Asynchronous and Real-Time},
  author={Song, Python and Oh, Hyeonho and Singh, Ishika and Thomason, Jesse and Mandlekar, Ajay and Ancha, Siddharth},
  journal={IEEE International Conference on Robotics and Automation (ICRA)},
  year={2026},
  preview={asyncrobosim.png},
  website={https://corl26-async-robosim.dgrnd8pzg9mss.amplifyapp.com/},
  code={https://anonymous.4open.science/r/realtime-robosuite},
  pdf={https://siddancha.github.io/asyncrobosim/paper.pdf},
  video={https://corl26-async-robosim.dgrnd8pzg9mss.amplifyapp.com/media/talk.mp4},
  abstract={Current robot simulation benchmarks run policies synchronously, giving unlimited thinking time per step -- unrealistic for real-world deployment. We introduce AsyncRoboSim, which runs the policy and simulator in parallel processes communicating through shared observation/action queues, while the simulator keeps advancing in real time. This better reflects real inference latency and improves correlation between simulation and real-world performance.},
  selected={true}
}

